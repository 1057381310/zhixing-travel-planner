# ============== LLM 配置 ==============
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL_NAME=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============== LangSmith 配置（可选）==============
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zhixing-travel-planer

# ============== 数据库配置 ==============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_planner_db
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:5432/travel_planner_db

# ============== Redis 配置 ==============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============== MCP 服务配置 ==============
AMAP_API_KEY=your-amap-key
TAVILY_API_KEY=your-tavily-key
VARIFLIGHT_API_KEY=your-variflight-key
AIGOHOTEL_MCP_API=your-rollinggo-mcp-key

# ============== 应用配置 ==============
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=14726
DEBUG=true
